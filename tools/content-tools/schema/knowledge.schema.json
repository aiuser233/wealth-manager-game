{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "知识词条（五件套）",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^k_[a-z0-9_]{3,40}$" },
    "title": { "type": "string", "minLength": 2, "maxLength": 30 },
    "unlockYear": { "type": "integer", "minimum": 2006, "maximum": 2025 },
    "category": { "type": "string", "enum": ["basics", "product", "market", "compliance", "planning", "behavior"] },
    "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 4 },
    "what": { "type": "string", "minLength": 10, "maxLength": 500 },
    "why": { "type": "string", "minLength": 10, "maxLength": 500 },
    "how": { "type": "string", "minLength": 5, "maxLength": 500 },
    "pitfall": { "type": "string", "minLength": 5, "maxLength": 300 },
    "quiz": {
      "type": "object",
      "properties": {
        "q": { "type": "string", "minLength": 4, "maxLength": 200 },
        "a": { "type": "string", "minLength": 2, "maxLength": 300 }
      },
      "required": ["q", "a"]
    },
    "review": { "$ref": "common.schema.json" }
  },
  "required": ["id", "title", "unlockYear", "category", "tags", "what", "why", "how", "pitfall", "quiz", "review"]
}

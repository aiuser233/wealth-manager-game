{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "重生之我是理财经理",
  "version": "0.1.0",
  "identifier": "com.fmgame.wealthmanager",
  "build": {
    "frontendDist": "../packages/ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @fm/ui",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "重生之我是理财经理 · 汇诚工作台",
        "width": 1280,
        "height": 800,
        "minWidth": 375,
        "minHeight": 667,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese"]
      }
    }
  }
}
